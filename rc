#!/bin/sh
# Run this RC's command line from a POSIX shell (macOS, Linux, WSL, Git Bash): ./rc check, ./rc ingest run, ...
# uv runs rc.py in the environment pinned by pyproject.toml and uv.lock, creating it on first use.
here="$(cd -- "$(dirname -- "$0")" && pwd)"
exec uv run --project "$here" --frozen --quiet python "$here/rc.py" "$@"
