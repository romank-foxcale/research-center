#!/usr/bin/env bash
set -euo pipefail

rc_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  printf '%s\n' \
    'Usage: ./rc <command> [arguments]' \
    '' \
    'Commands:' \
    '  doctor         Check Nix, gh and the provider logins (claude, codex, cursor-agent)' \
    '  show           Show flake packages, checks and apps' \
    '  check          Evaluate and build every flake check' \
    '  validate       Validate the docs/ knowledge graph and the research center contract' \
    '  agents <sync|check>  Mirror .agents/skills into .claude/skills and the rule hooks' \
    '  bootstrap install <dir>  Materialize a new instance from this template' \
    '  bootstrap validate       Validate the research center contract' \
    '  ingest add <folder|git|url|notion|gdrive> <locator...> [--id] [--include] [--exclude] [--note]' \
    '  ingest list | remove <id>' \
    '  ingest run [id...] [--budget N] [--profile|--no-profile]  Fetch, digest, profile' \
    '  research new <topic> --title "..." | accept <topic> | list | show <topic>' \
    '  research run <topic> [--from plan|collect|analyze|critique|judge|apply|report] [--budget N]' \
    '  watch [run]    Follow an ingest or research run live: steps, agent talk, stalls, result' \
    '  roles [list] | roles set <role> [--provider claude|codex|cursor] [--model M]' \
    '  plan <create|list|show|accept|archive|complete> ...  Plans for changing this RC itself'
}

require_nix() {
  if ! command -v nix >/dev/null 2>&1; then
    printf '%s\n' 'error: Nix is not installed; see https://nixos.org/download/' >&2
    exit 1
  fi
}

# Write or refresh flake.lock before evaluating: when an evaluation creates the lock
# itself, Nix sees the source tree change mid-evaluation and aborts.
lock_flake() {
  nix flake lock "$rc_root" --quiet
}

# Ingest and research run with converters from nix/tools.nix on PATH, ahead of the user's agent CLIs.
# Built from that file alone, so a large instance is not copied into the store on every command.
with_tools() {
  require_nix
  local tools
  tools="$(nix build --no-link --print-out-paths --file "$rc_root/nix/tools.nix")"
  PATH="$tools/bin:$PATH" exec python3 "$@"
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  doctor)
    require_nix
    nix --version
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
      printf '%s\n' 'gh: logged in'
    else
      printf '%s\n' 'note: gh is missing or not logged in; ingest cannot check that the remote is private'
    fi
    python3 "$rc_root/scripts/runner/providers.py" status
    ;;
  show)
    require_nix
    lock_flake
    exec nix flake show "$rc_root" "$@"
    ;;
  check)
    require_nix
    lock_flake
    exec nix flake check "$rc_root" --keep-going "$@"
    ;;
  validate)
    python3 "$rc_root/scripts/validate-knowledge.py" "$rc_root"
    exec python3 "$rc_root/scripts/validate-research-center.py" "$rc_root"
    ;;
  agents)
    exec python3 "$rc_root/scripts/agent-configs.py" "$rc_root" "${1:-check}"
    ;;
  bootstrap)
    bootstrap_command="${1:-help}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$bootstrap_command" in
      install)
        exec python3 "$rc_root/scripts/materialize-template.py" "${1:?usage: ./rc bootstrap install <dir>}"
        ;;
      validate)
        exec python3 "$rc_root/scripts/validate-research-center.py" "$rc_root"
        ;;
      *)
        printf '%s\n' 'usage: ./rc bootstrap <install <dir>|validate>' >&2
        exit 2
        ;;
    esac
    ;;
  ingest)
    with_tools "$rc_root/scripts/ingest/ingest.py" "$rc_root" "$@"
    ;;
  research)
    with_tools "$rc_root/scripts/research/research.py" "$rc_root" "$@"
    ;;
  watch)
    exec python3 "$rc_root/scripts/runner/events.py" "$rc_root" "$@"
    ;;
  roles)
    exec python3 "$rc_root/scripts/roles.py" "$rc_root" "$@"
    ;;
  plan)
    exec python3 "$rc_root/scripts/plans.py" "$rc_root" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'error: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
