/result
/result-*
/.direnv/
/docs/.obsidian/
__pycache__/

# Personal AI tool settings: each person uses their own account and preferences.
/.claude/settings.local.json
/CLAUDE.local.md
/AGENTS.override.md
/.cursor/*.local.*
