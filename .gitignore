# Local run state: event streams, agent logs, reviewer mappings, git clone cache. Never committed.
.rc-local/

# The temporary template clone used to create or migrate an RC (see BOOTSTRAP.md).
/rc_template/

# Local and derived artifacts.
/.venv/
/docs/.obsidian/
__pycache__/

# Personal AI tool settings: each person uses their own account and preferences.
/.claude/settings.local.json
/CLAUDE.local.md
/AGENTS.override.md
/.cursor/*.local.*
