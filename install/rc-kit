#!/bin/sh
# rc-kit launcher for POSIX shells (macOS, Linux, WSL). install.sh links it into ~/.local/bin.
# Resolves that link back to the kit clone, then runs rc_kit.py with uv in the kit's locked environment.
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
kit="$(cd -- "$(dirname -- "$self")/.." && pwd)"
exec uv run --project "$kit" --frozen --quiet python "$kit/install/rc_kit.py" "$@"
